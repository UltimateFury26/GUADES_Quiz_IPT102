<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="_24_1571GuadesPersonalPortfolio.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <title></title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" type="text/css" href="~/24-1571GuadesPersonalPortfolio_Styles/Portfolio.css" runat="server" />
</head>
<body>
    <form id="form1" runat="server">

        <!-- ICON RAIL -->
        <nav id="iconRail" aria-label="Primary">
            <a class="rail-logo" href="<%= ResolveUrl("~/Home.aspx") %>" title="Home"><%: Initials %></a>

            <button type="button" class="rail-close" id="railClose" aria-label="Close menu">
                <svg class="icon" viewBox="0 0 24 24"><path d="M6 6l12 12" /><path d="M18 6 6 18" /></svg>
            </button>

            <div class="rail-links">
                <a class="rail-btn<%= ActiveClass("~/Home.aspx") %>" href="<%= ResolveUrl("~/Home.aspx") %>" title="Home">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M4 11.5 12 4l8 7.5" /><path d="M6 10v9a1 1 0 0 0 1 1h3v-5h4v5h3a1 1 0 0 0 1-1v-9" /></svg>
                    <span class="rail-label">Home</span>
                </a>
                <a class="rail-btn" href="<%= ResolveUrl("~/Home.aspx") %>#boards" title="Boards">
                    <svg class="icon" viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.5" /><rect x="13" y="4" width="7" height="7" rx="1.5" /><rect x="4" y="13" width="7" height="7" rx="1.5" /><rect x="13" y="13" width="7" height="7" rx="1.5" /></svg>
                    <span class="rail-label">Boards</span>
                </a>
                <a class="rail-btn<%= ActiveClass("~/MyAccount.aspx") %>" href="<%= ResolveUrl("~/MyAccount.aspx") %>" title="My Account">
                    <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
                    <span class="rail-label">My Account</span>
                </a>
            </div>

            <% if (IsAdmin) { %>
            <div class="rail-divider"></div>
            <div class="rail-links">
                <a class="rail-btn<%= ActiveClass("~/Admin/ManageUsers.aspx") %>" href="<%= ResolveUrl("~/Admin/ManageUsers.aspx") %>" title="Users">
                    <svg class="icon" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7" /><path d="M18 14.3c2 .7 3.5 2.6 3.5 5.7" /></svg>
                    <span class="rail-label">Users</span>
                </a>
                <a class="rail-btn<%= ActiveClass("~/Admin/ManageContent.aspx") %>" href="<%= ResolveUrl("~/Admin/ManageContent.aspx") %>" title="Content">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M4 20h4L19 9l-4-4L4 16v4z" /><path d="M13.5 6.5l4 4" /></svg>
                    <span class="rail-label">Content</span>
                </a>
                <a class="rail-btn<%= ActiveClass("~/Admin/ManagePosts.aspx") %>" href="<%= ResolveUrl("~/Admin/ManagePosts.aspx") %>" title="Posts">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M3 11v2a1 1 0 0 0 1 1h3l6 4V6L7 10H4a1 1 0 0 0-1 1z" /><path d="M16.5 8.5a5 5 0 0 1 0 7" /></svg>
                    <span class="rail-label">Posts</span>
                </a>
                <a class="rail-btn<%= ActiveClass("~/Admin/Reports.aspx") %>" href="<%= ResolveUrl("~/Admin/Reports.aspx") %>" title="Reports">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M4 20V10" /><path d="M10 20V4" /><path d="M16 20v-7" /><path d="M22 20H2" /></svg>
                    <span class="rail-label">Reports</span>
                </a>
            </div>
            <% } %>

            <div class="rail-spacer"></div>

            <div class="rail-links">
                <% if (GitHubUrl.Length > 0) { %>
                <a class="rail-btn" href="<%: GitHubUrl %>" target="_blank" rel="noopener" title="GitHub">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M9 18 3 12l6-6" /><path d="M15 6l6 6-6 6" /></svg>
                    <span class="rail-label">GitHub</span>
                </a>
                <% } %>
                <% if (LinkedInUrl.Length > 0) { %>
                <a class="rail-btn" href="<%: LinkedInUrl %>" target="_blank" rel="noopener" title="LinkedIn">
                    <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="12" rx="2" /><path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><path d="M3 13h18" /></svg>
                    <span class="rail-label">LinkedIn</span>
                </a>
                <% } %>
                <% if (Email.Length > 0) { %>
                <a class="rail-btn" href="mailto:<%: Email %>" title="Email">
                    <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M4 7l8 6 8-6" /></svg>
                    <span class="rail-label">Email</span>
                </a>
                <% } %>
                <button type="button" class="rail-btn" data-modal="contactModal" title="Contact">
                    <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="12" r="2" /><path d="M14 10h5" /><path d="M14 14h5" /></svg>
                    <span class="rail-label">Contact</span>
                </button>
            </div>
        </nav>

        <!-- Backdrop behind the rail on phone width. Clicking it, or Esc, closes the rail. -->
        <div class="rail-backdrop" id="railBackdrop"></div>

        <!-- TOP BAR -->
        <div id="topBar">
            <button type="button" id="railToggle" class="rail-toggle" aria-label="Toggle menu">
                <svg class="icon" viewBox="0 0 24 24"><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></svg>
            </button>

            <% if (ShowSearch) { %>
            <div class="search-form">
                <span class="search-icon">
                    <svg class="icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
                </span>
                <input type="text" id="boardSearch" placeholder="Search boards" autocomplete="off" />
            </div>
            <% } %>

            <details class="account-menu" id="accountMenu">
                <summary class="account-toggle" aria-label="Account menu">
                    <span class="account-initial"><%: AccountInitial %></span>
                    <span class="account-name"><%: AccountName %></span>
                </summary>
                <div class="account-dropdown">
                    <p class="account-role">Signed in as <%: AccountName %> (<%: AccountRole %>)</p>
                    <a class="account-item" href="<%= ResolveUrl("~/MyAccount.aspx") %>">My Account</a>
                    <asp:LinkButton ID="lnkLogout" runat="server" CssClass="account-item" CausesValidation="false" OnClick="lnkLogout_Click">Log out</asp:LinkButton>
                </div>
            </details>
        </div>

        <!-- MAIN BODY -->
        <main class="site-body">
            <div class="page-inner" id="top">

                <% if (NoticeText.Length > 0) { %>
                <div class="alert alert-error" role="alert"><%: NoticeText %></div>
                <% } %>

                <asp:ContentPlaceHolder ID="MainContent" runat="server" />

                <!-- FOOTER -->
                <footer class="site-footer">
                    <p class="footer-copy">&copy; <%: DateTime.Now.Year %> <%: OwnerName %>. All rights reserved.</p>
                    <div class="footer-socials">
                        <% if (GitHubUrl.Length > 0) { %>
                        <a href="<%: GitHubUrl %>" target="_blank" rel="noopener" class="footer-social-link">
                            <svg class="icon" viewBox="0 0 24 24"><path d="M9 18 3 12l6-6" /><path d="M15 6l6 6-6 6" /></svg>
                            GitHub
                        </a>
                        <% } %>
                        <% if (LinkedInUrl.Length > 0) { %>
                        <a href="<%: LinkedInUrl %>" target="_blank" rel="noopener" class="footer-social-link">
                            <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="12" rx="2" /><path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><path d="M3 13h18" /></svg>
                            LinkedIn
                        </a>
                        <% } %>
                    </div>
                </footer>

            </div>
        </main>

        <!-- CONTACT MODAL (owner's details, from the database) -->
        <div class="modal-overlay" id="contactModal">
            <div class="modal-box">
                <button type="button" class="modal-close" data-close>
                    <svg class="icon" viewBox="0 0 24 24"><path d="M6 6l12 12" /><path d="M18 6 6 18" /></svg>
                </button>
                <h3>Contact</h3>
                <% if (Email.Length > 0) { %>
                <div class="contact-row">
                    <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M4 7l8 6 8-6" /></svg>
                    <a href="mailto:<%: Email %>"><%: Email %></a>
                </div>
                <% } %>
                <% if (PhoneDisplay.Length > 0) { %>
                <div class="contact-row">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M15.5 16.5c-4-1-8-5-9-9l2.4-2a1 1 0 0 0 .3-1.1L8 1.8A1 1 0 0 0 7 1.2L4 2c-.8 6.5 5.3 12.6 11.8 12l.8-3a1 1 0 0 0-.6-1l-2.6-1.2a1 1 0 0 0-1.1.3l-2 2.4" /></svg>
                    <span><%: PhoneDisplay %></span>
                </div>
                <% } %>
                <% if (Address.Length > 0) { %>
                <div class="contact-row">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M12 22s7-7.2 7-12a7 7 0 1 0-14 0c0 4.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>
                    <span><%: Address %></span>
                </div>
                <% } %>
            </div>
        </div>

        <script src="<%= ResolveUrl("~/24-1571GuadesPersonalPortfolio_Scripts/Portfolio.js") %>"></script>
    </form>
</body>
</html>